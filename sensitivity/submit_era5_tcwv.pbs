echo "====================================================================="
echo ">>> ERA5 TCWV DOWNLOAD"
echo "Job ID  : $PBS_JOBID"
echo "Host    : $(hostname)"
echo "Start   : $(date)"
echo "====================================================================="

module load conda
conda activate npl

python -c "import cdsapi; print('cdsapi OK')" 2>/dev/null || pip install cdsapi --quiet

python /glade/work/jrotondo/ncc_paper/python/download_era5_tcwv.py

echo "====================================================================="
echo ">>> DONE at $(date)"
echo "====================================================================="
